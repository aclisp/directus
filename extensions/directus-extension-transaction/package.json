{
	"name": "directus-extension-transaction",
	"description": "Please enter a description for your extension",
	"license": "MIT",
	"icon": "extension",
	"version": "1.0.0",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-bundle"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "operation",
				"name": "transactional-exec",
				"source": {
					"app": "src/transactional-exec/app.ts",
					"api": "src/transactional-exec/api.ts"
				}
			}
		],
		"host": "^10.10.0"
	},
	"scripts": {
		"build": "directus-extension build --no-minify --sourcemap",
		"dev": "directus-extension build -w --no-minify --sourcemap",
		"link": "directus-extension link",
		"validate": "directus-extension validate",
		"add": "directus-extension add"
	},
	"dependencies": {
		"@directus/api": "workspace:*",
		"@directus/env": "workspace:*",
		"@directus/errors": "workspace:*",
		"nanoid": "catalog:",
		"zod": "catalog:",
		"zod-validation-error": "catalog:"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "workspace:*",
		"@directus/types": "workspace:*",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vue": "catalog:"
	}
}
